# DIAMBRA engine settings for Apptainer on the VSC.
# FILL THESE IN from diambra_engine_info.txt (made by tools/inspect_diambra_engine.sh on a laptop with Docker).
# Everything marked TODO is a guess until Step 0 is done.

ENGINE_IMAGE="docker://diambra/engine:latest"        # TODO: exact "Image" from docker inspect
ENGINE_SIF="$VSC_DATA/diambra-engine.sif"             # local Apptainer image (built once by apptainer pull)

# Command the container runs, with {PORT} where the listening port goes.
# TODO: copy "Path" + "Args" from docker inspect; find the flag that sets the port (if any).
ENGINE_CMD="{ENTRYPOINT} --port {PORT}"               # TODO

ROMS_DIR="$VSC_DATA/roms"                             # folder with sfiii3n.zip
ROMS_MOUNT="/opt/diambraArena/roms"                   # TODO: container path of the ROM mount ("Mounts" -> Destination)
CREDS_FILE="$HOME/.diambra/credentials"               # copy this file from your laptop after `diambra` login
CREDS_MOUNT="/tmp/.diambra/credentials"               # TODO: container path of the credentials mount
BASE_PORT=50051
